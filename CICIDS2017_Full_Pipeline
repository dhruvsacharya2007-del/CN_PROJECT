        "# ============================================================\n",
        "# ABLATION: Random Forest vs XGBoost  (detector comparison)\n",
        "# Paste as ONE new cell at the END of the CICIDS2017 notebook.\n",
        "#\n",
        "# Needs in memory from Phase 2: X_train, X_test, y_train, y_test, le, rf\n",
        "#\n",
        "# WHY THIS EXISTS:\n",
        "#   Guide suggested XGBoost for faster performance. This measures it properly\n",
        "#   instead of arguing about it: accuracy, training time, per-flow inference\n",
        "#   latency, AND per-flow SHAP latency for both models.\n",
        "#\n",
        "#   The key question is not \"which classifier is faster\" but \"does a faster\n",
        "#   classifier move the END-TO-END latency\" - since SHAP, not inference, is\n",
        "#   the pipeline bottleneck. This table answers that with numbers.\n",
        "# ============================================================\n",
        "\n",
        "import importlib, subprocess, sys\n",
        "for _pkg in (\"xgboost\", \"shap\"):\n",
        "    if importlib.util.find_spec(_pkg) is None:\n",
        "        subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", _pkg], check=True)\n",
        "\n",
        "import numpy as np, pandas as pd, time, shap\n",
        "from xgboost import XGBClassifier\n",
        "from sklearn.metrics import accuracy_score, f1_score, classification_report\n",
        "from sklearn.utils.class_weight import compute_sample_weight\n",
        "\n",
        "for _v in [\"X_train\", \"X_test\", \"y_train\", \"y_test\", \"le\", \"rf\"]:\n",
        "    assert _v in globals(), f\"{_v} missing - re-run the Phase 2 cells first.\"\n",
        "\n",
        "n_classes = len(le.classes_)\n",
        "print(f\"Ablation on {X_train.shape[0]:,} train / {X_test.shape[0]:,} test flows, \"\n",
        "      f\"{X_train.shape[1]} features, {n_classes} classes.\\n\")\n",
        "\n",
        "\n",
        "# ---------- helper: timed per-flow inference ----------\n",
        "def inference_latency_ms(model, X, n=200, repeats=5):\n",
        "    \"\"\"Median single-flow predict time. Warm-up discarded.\"\"\"\n",
        "    _ = model.predict(X.iloc[[0]])                       # warm-up\n",
        "    times = []\n",
        "    for i in range(min(n, len(X))):\n",
        "        row = X.iloc[[i]]\n",
        "        reps = []\n",
        "        for _ in range(repeats):\n",
        "            t = time.perf_counter()\n",
        "            _ = model.predict(row)\n",
        "            reps.append((time.perf_counter() - t) * 1000.0)\n",
        "        times.append(np.median(reps))\n",
        "    return float(np.median(times))\n",
        "\n",
        "\n",
        "# ---------- helper: timed per-flow SHAP ----------\n",
        "def shap_latency_ms(explainer, X, n=100, repeats=3):\n",
        "    _ = explainer.shap_values(X.iloc[[0]])               # warm-up\n",
        "    times = []\n",
        "    for i in range(min(n, len(X))):\n",
        "        row = X.iloc[[i]]\n",
        "        reps = []\n",
        "        for _ in range(repeats):\n",
        "            t = time.perf_counter()\n",
        "            _ = explainer.shap_values(row)\n",
        "            reps.append((time.perf_counter() - t) * 1000.0)\n",
        "        times.append(np.median(reps))\n",
        "    return float(np.median(times))\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 0. Re-time RF training so both numbers are measured the same way\n",
        "# ============================================================\n",
        "from sklearn.base import clone\n",
        "_rf_timer = clone(rf)\n",
        "t0 = time.time()\n",
        "_rf_timer.fit(X_train, y_train)\n",
        "rf_train_s = time.time() - t0\n",
        "del _rf_timer\n",
        "print(f\"Random Forest trained in {rf_train_s:.1f}s\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# 1. XGBoost - same data, same split, class-imbalance handled\n",
        "# ============================================================\n",
        "# RF used class_weight=\"balanced\". XGBoost's multiclass equivalent is\n",
        "# per-sample weights, so we compute the same balanced weighting.\n",
        "sw = compute_sample_weight(class_weight=\"balanced\", y=y_train)\n",
        "\n",
        "xgb = XGBClassifier(\n",
        "    n_estimators=100,          # matched to RF's 100 trees\n",
        "    max_depth=6,\n",
        "    learning_rate=0.3,\n",
        "    tree_method=\"hist\",        # fast CPU histogram algorithm\n",
        "    n_jobs=-1,\n",
