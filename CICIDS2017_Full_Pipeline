        "TRAIN_DEVICE = \"auto\"\n",
        "EPOCHS       = 30\n",
        "BATCH        = 512\n",
        "HIDDEN       = (128, 64)\n",
        "DROPOUT      = 0.2\n",
        "LR           = 1e-3\n",
        "SEED         = 42\n",
        "# ============================================================\n",
        "\n",
        "import os, time, warnings\n",
        "import numpy as np\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "for _v in [\"X_train\", \"y_train\", \"X_test\", \"y_test\", \"le\"]:\n",
        "    assert _v in globals(), f\"{_v} missing.\"\n",
        "\n",
        "import torch, torch.nn as nn\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.metrics import (accuracy_score, precision_score, recall_score,\n",
        "                             f1_score, classification_report)\n",
        "\n",
        "torch.set_num_threads(1)\n",
        "os.environ.setdefault(\"OMP_NUM_THREADS\", \"1\")\n",
        "torch.manual_seed(SEED); np.random.seed(SEED)\n",
        "\n",
        "if TRAIN_DEVICE == \"auto\":\n",
        "    DEV = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "else:\n",
        "    DEV = torch.device(TRAIN_DEVICE)\n",
        "print(f\"training on {DEV.type}, scoring on cpu\")\n",
        "\n",
        "Xtr_raw = np.array(X_train, dtype=np.float64, copy=True)\n",
        "Xte_raw = np.array(X_test,  dtype=np.float64, copy=True)\n",
        "ytr = np.asarray(y_train).astype(np.int64)\n",
        "yte = np.asarray(y_test).astype(np.int64)\n",
        "for A in (Xtr_raw, Xte_raw):\n",
        "    np.nan_to_num(A, copy=False, nan=0.0, posinf=0.0, neginf=0.0)\n",
        "\n",
        "if TRAIN_N and TRAIN_N < len(Xtr_raw):\n",
        "    _i = np.random.RandomState(SEED).choice(len(Xtr_raw), TRAIN_N, replace=False)\n",
        "    Xtr_raw, ytr = Xtr_raw[_i], ytr[_i]\n",
        "print(f\"{DATASET}: {len(Xtr_raw):,} train rows, {Xtr_raw.shape[1]} features, \"\n",
        "      f\"{len(le.classes_)} classes\")\n",
        "\n",
        "scaler_unw = StandardScaler().fit(Xtr_raw)\n",
        "Xtr = scaler_unw.transform(Xtr_raw).astype(np.float32)\n",
        "Xte = scaler_unw.transform(Xte_raw).astype(np.float32)\n",
        "N_FEAT, N_CLASSES = Xtr.shape[1], len(le.classes_)\n",
        "\n",
        "# ---- identical architecture, FLAT loss ----\n",
        "layers, prev = [], N_FEAT\n",
        "for h in HIDDEN:\n",
        "    layers += [nn.Linear(prev, h), nn.ReLU(), nn.Dropout(DROPOUT)]; prev = h\n",
        "layers += [nn.Linear(prev, N_CLASSES)]\n",
        "model_unw = nn.Sequential(*layers).to(DEV)\n",
        "\n",
        "opt   = torch.optim.Adam(model_unw.parameters(), lr=LR)\n",
        "lossf = nn.CrossEntropyLoss()                 # <-- the only difference\n",
        "print(\"loss: unweighted (CrossEntropyLoss with no class weights)\")\n",
        "\n",
        "rs   = np.random.RandomState(SEED)\n",
        "perm = rs.permutation(len(Xtr))\n",
        "nval = max(1, int(0.1 * len(Xtr)))\n",
        "vi, ti = perm[:nval], perm[nval:]\n",
        "Xt = torch.from_numpy(Xtr[ti]).to(DEV); yt = torch.from_numpy(ytr[ti]).to(DEV)\n",
        "Xv = torch.from_numpy(Xtr[vi]).to(DEV); yv = torch.from_numpy(ytr[vi]).to(DEV)\n",
        "\n",
        "best, best_state, bad, patience = float(\"inf\"), None, 0, 5\n",
        "t0 = time.perf_counter()\n",
        "for ep in range(EPOCHS):\n",
        "    model_unw.train()\n",
        "    order = torch.randperm(len(Xt), device=DEV)\n",
        "    for i in range(0, len(Xt), BATCH):\n",
        "        b = order[i:i + BATCH]\n",
        "        opt.zero_grad(); lossf(model_unw(Xt[b]), yt[b]).backward(); opt.step()\n",
        "    model_unw.eval()\n",
        "    with torch.no_grad():\n",
        "        tot, n = 0.0, 0\n",
        "        for i in range(0, len(Xv), 8192):\n",
        "            xb, yb = Xv[i:i + 8192], yv[i:i + 8192]\n",
        "            tot += lossf(model_unw(xb), yb).item() * len(xb); n += len(xb)\n",
        "        vl = tot / max(n, 1)\n",
        "    if vl < best - 1e-5:\n",
        "        best, bad = vl, 0\n",
        "        best_state = {k: v.detach().clone() for k, v in model_unw.state_dict().items()}\n",
        "    else:\n",
        "        bad += 1\n",
        "        if bad >= patience:\n",
        "            print(f\"  early stop at epoch {ep + 1}\"); break\n",
        "    if (ep + 1) % 5 == 0:\n",
        "        print(f\"  epoch {ep + 1:3d}  val loss {vl:.4f}\")\n",
        "\n",
        "if best_state is not None:\n",
        "    model_unw.load_state_dict(best_state)\n",
        "if DEV.type == \"cuda\":\n",
        "    torch.cuda.synchronize()\n",
        "print(f\"\\ntrained in {time.perf_counter() - t0:.1f}s on {DEV.type}\")\n",
        "\n",
        "model_unw = model_unw.to(torch.device(\"cpu\")); model_unw.eval()\n",
        "del Xt, yt, Xv, yv\n",
        "if DEV.type == \"cuda\":\n",
        "    torch.cuda.empty_cache()\n",
        "\n",
