        "# ============================================================\n",
        "# REWARD-FUNCTION ABLATION  (requested: variable reward by severity / volume)\n",
        "#\n",
        "# Current reward is severity-graded but FLAT in magnitude: a 694-packet scan\n",
        "# and a 464,475-packet flood both score +1.0 when handled correctly. This cell\n",
        "# tests whether scaling the reward by impact changes the policy.\n",
        "#\n",
        "# Four variants, same 100-seed protocol, same data, nothing else altered:\n",
        "#   R0  flat          the current function (baseline)\n",
        "#   R1  severity      x weight of the TRUE class's severity\n",
        "#   R2  volume        x log-scaled packet/byte count of the flow\n",
        "#   R3  volume-in-class   volume normalised WITHIN each class\n",
        "#\n",
        "# WHY R3 EXISTS: packet count correlates with class (floods are big, scans are\n",
        "# small), so R2 is partly class-weighting in disguise. R3 strips the class\n",
        "# signal out and leaves only \"is this a big instance of its own type\". If R3\n",
        "# helps, that is a real finding. If only R2 helps, it is class weighting and\n",
        "# must be reported as such.\n",
        "#\n",
        "# Paste as ONE cell AFTER the dataset's Phase 3 cells (needs the attribution\n",
        "# file) AND with X_test in memory so flow volume can be recovered.\n",
        "#\n",
        "# Runtime: ~8-15 min (4 variants x 100 seeds).\n",
        "# ============================================================\n",
        "\n",
        "DATASET = \"CICIDS2017\"        # label only, for the saved filenames\n",
        "SEEDS   = 100\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np, pandas as pd, os, glob\n",
        "from collections import defaultdict\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.model_selection import train_test_split\n",
        "from scipy import stats\n",
        "\n",
        "CAND = [\"/content/artifacts\", \"/content/drive/MyDrive/CN_PROJECT/artifacts\"]\n",
        "TAG  = DATASET.lower().replace(\" \", \"\")\n",
        "\n",
        "# ---------------- load the attribution vectors ----------------\n",
        "base = None\n",
        "for b in CAND:\n",
        "    hits = glob.glob(f\"{b}/shap_attributions*.parquet\")\n",
        "    if hits:\n",
        "        base, attr_path = b, sorted(hits)[-1]; break\n",
        "assert base, \"No shap_attributions*.parquet found - run Phase 3 first.\"\n",
        "attr_df = pd.read_parquet(attr_path)\n",
        "print(f\"attributions: {os.path.basename(attr_path)}  ({len(attr_df):,} flows)\")\n",
