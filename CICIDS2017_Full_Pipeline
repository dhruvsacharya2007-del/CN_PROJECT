        "          f\"(median {np.median(volume):.1f}, max {volume.max():.1f})\")\n",
        "\n",
        "# ---------------- the four reward functions ----------------\n",
        "def base_reward(tc, a):\n",
        "    ideal = IDEAL[tc]\n",
        "    if a == ideal: return 1.0\n",
        "    if tc == \"Normal Traffic\" and a != \"allow\": return -1.0\n",
