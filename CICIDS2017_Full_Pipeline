        "# ============================================================\n",
        "# REWARD-FUNCTION ABLATION  (requested: variable reward by severity / volume)\n",
        "#\n",
        "# Current reward is severity-graded but FLAT in magnitude: a 694-packet scan\n",
        "# and a 464,475-packet flood both score +1.0 when handled correctly. This cell\n",
        "# tests whether scaling the reward by impact changes the policy.\n",
        "#\n",
        "# Four variants, same 100-seed protocol, same data, nothing else altered:\n",
        "#   R0  flat          the current function (baseline)\n",
        "#   R1  severity      x weight of the TRUE class's severity\n",
        "#   R2  volume        x log-scaled packet/byte count of the flow\n",
        "#   R3  volume-in-class   volume normalised WITHIN each class\n",
        "#\n",
        "# WHY R3 EXISTS: packet count correlates with class (floods are big, scans are\n",
        "# small), so R2 is partly class-weighting in disguise. R3 strips the class\n",
        "# signal out and leaves only \"is this a big instance of its own type\". If R3\n",
        "# helps, that is a real finding. If only R2 helps, it is class weighting and\n",
        "# must be reported as such.\n",
        "#\n",
        "# Paste as ONE cell AFTER the dataset's Phase 3 cells (needs the attribution\n",
        "# file) AND with X_test in memory so flow volume can be recovered.\n",
        "#\n",
        "# Runtime: ~8-15 min (4 variants x 100 seeds).\n",
        "# ============================================================\n",
        "\n",
        "DATASET = \"CICIDS2017\"        # label only, for the saved filenames\n",
        "SEEDS   = 100\n",
        "# ============================================================\n",
        "\n",
        "import numpy as np, pandas as pd, os, glob\n",
        "from collections import defaultdict\n",
        "from sklearn.preprocessing import StandardScaler\n",
        "from sklearn.model_selection import train_test_split\n",
        "from scipy import stats\n",
        "\n",
        "CAND = [\"/content/artifacts\", \"/content/drive/MyDrive/CN_PROJECT/artifacts\"]\n",
        "TAG  = DATASET.lower().replace(\" \", \"\")\n",
        "\n",
        "# ---------------- load the attribution vectors ----------------\n",
        "# PINNED, not globbed. The earlier version took sorted(hits)[-1] and silently\n",
        "# picked a Random-Forest-era file, which made the ablation describe a different\n",
        "# detector from the one the paper puts forward. Never glob this again.\n",
        "PINNED = \"shap_attributions_xgb_cicids2017.parquet\"\n",
        "\n",
        "attr_path = None\n",
        "for b in CAND:\n",
        "    p = os.path.join(b, PINNED)\n",
        "    if os.path.exists(p):\n",
        "        attr_path = p; break\n",
        "if attr_path is None:\n",
        "    seen = sorted({os.path.basename(h) for b in CAND\n",
        "                   for h in glob.glob(f\"{b}/shap_attributions*.parquet\")})\n",
        "    raise SystemExit(\n",
        "        f\"{PINNED} not found. Generate it from the XGBoost model first.\\n\"\n",
        "        f\"Files present: {seen or 'none'}\")\n",
        "\n",
        "attr_df = pd.read_parquet(attr_path)\n",
        "print(f\"attributions: {os.path.basename(attr_path)}  ({len(attr_df):,} flows)\")\n",
        "print(\"  ^ XGBoost attributions - matches the detector the paper puts forward\")\n",
        "\n",
        "shap_cols   = [c for c in attr_df.columns if c.startswith(\"shap_\")]\n",
        "X_attr      = attr_df[shap_cols].to_numpy()\n",
        "true_classes = attr_df[\"true_class\"].to_numpy()\n",
        "dominant    = np.abs(X_attr).argmax(axis=1)\n",
        "\n",
        "ACTIONS  = [\"allow\", \"rate_limit\", \"isolate\", \"block\"]\n",
        "SEVERITY = {\"allow\": 0, \"rate_limit\": 1, \"isolate\": 2, \"block\": 3}\n",
        "IDEAL = {\"Normal Traffic\": \"allow\", \"Port Scanning\": \"rate_limit\",\n",
        "         \"Brute Force\": \"isolate\", \"Web Attacks\": \"isolate\", \"Bots\": \"isolate\",\n",
        "         \"DoS\": \"block\", \"DDoS\": \"block\",\n",
        "         \"MITM\": \"isolate\", \"DNS Spoofing\": \"isolate\"}\n",
        "for c in np.unique(true_classes):\n",
        "    IDEAL.setdefault(c, \"isolate\")\n",
        "\n",
        "# ---------------- recover per-flow VOLUME ----------------\n",
        "# the attribution rows are the first N rows of X_explain, which came from\n",
        "# X_test; match on length and take a packet/byte-like column.\n",
        "VOL_CANDIDATES = [\n",
        "    \"Total Fwd Packets\", \"Total Backward Packets\", \"Tot Fwd Pkts\",\n",
        "    \"total_fwd_packets\", \"Number\", \"Tot sum\", \"Tot size\",\n",
        "    \"Total Length of Fwd Packets\", \"flow_pkts_s\", \"Flow Packets/s\",\n",
        "    \"Packet Length Mean\", \"Average Packet Size\", \"Header_Length\",\n",
        "]\n",
        "volume, vol_col = None, None\n",
        "if \"X_test\" in globals():\n",
        "    cols = list(globals()[\"X_test\"].columns)\n",
        "    for c in VOL_CANDIDATES:\n",
        "        if c in cols:\n",
        "            vol_col = c; break\n",
        "    if vol_col is None:                       # any column that looks like a count\n",
        "        for c in cols:\n",
        "            lc = c.lower()\n",
        "            if \"packet\" in lc or \"pkt\" in lc or lc in (\"number\", \"tot sum\"):\n",
        "                vol_col = c; break\n",
        "    if vol_col is not None:\n",
        "        v = globals()[\"X_test\"][vol_col].to_numpy()\n",
        "        if len(v) >= len(attr_df):\n",
        "            volume = np.asarray(v[:len(attr_df)], dtype=float)\n",
        "\n",
        "if volume is None:\n",
        "    print(\"!! Could not recover a per-flow volume column.\")\n",
        "    print(\"   Columns searched:\", VOL_CANDIDATES[:6], \"...\")\n",
        "    print(\"   R2 and R3 will be SKIPPED; R0 and R1 still run.\")\n",
        "else:\n",
        "    volume = np.nan_to_num(volume, nan=0.0, posinf=0.0, neginf=0.0)\n",
        "    volume = np.clip(volume, 0, None)\n",
        "    print(f\"volume column: {vol_col!r}  \"\n",
        "          f\"(median {np.median(volume):.1f}, max {volume.max():.1f})\")\n",
        "\n",
        "# ---------------- the four reward functions ----------------\n",
        "def base_reward(tc, a):\n",
        "    ideal = IDEAL[tc]\n",
        "    if a == ideal: return 1.0\n",
        "    if tc == \"Normal Traffic\" and a != \"allow\": return -1.0\n",
        "    if tc != \"Normal Traffic\" and a == \"allow\": return -1.0\n",
        "    return max(-0.5, 0.5 - 0.5 * abs(SEVERITY[a] - SEVERITY[ideal]))\n",
        "\n",
        "# R1: severity weight, normalised to mean 1 so total reward scale is comparable\n",
        "sev_w = {c: 1.0 + SEVERITY[IDEAL[c]] for c in np.unique(true_classes)}\n",
        "_m = np.mean([sev_w[c] for c in true_classes]); sev_w = {k: v/_m for k, v in sev_w.items()}\n",
        "\n",
        "if volume is not None:\n",
        "    logv = np.log10(1.0 + volume)\n",
        "    w_vol = logv / max(logv.mean(), 1e-9)            # R2, mean 1\n",
        "    w_vin = np.ones_like(logv)                       # R3, mean 1 within class\n",
        "    for c in np.unique(true_classes):\n",
        "        m = true_classes == c\n",
        "        mu = logv[m].mean()\n",
        "        if mu > 1e-9:\n",
        "            w_vin[m] = logv[m] / mu\n",
        "\n",
        "VARIANTS = {\"R0 flat (current)\":      lambda i, tc, a: base_reward(tc, a),\n",
        "            \"R1 severity-weighted\":   lambda i, tc, a: base_reward(tc, a) * sev_w[tc]}\n",
        "if volume is not None:\n",
        "    VARIANTS[\"R2 volume-weighted\"]      = lambda i, tc, a: base_reward(tc, a) * w_vol[i]\n",
        "    VARIANTS[\"R3 volume-within-class\"]  = lambda i, tc, a: base_reward(tc, a) * w_vin[i]\n",
        "\n",
        "# ---------------- LinUCB (unchanged, alpha locked at 1.0) ----------------\n",
        "class LinUCB:\n",
        "    def __init__(self, n, d, alpha=1.0):\n",
        "        self.n, self.alpha = n, alpha\n",
        "        self.A = [np.identity(d) for _ in range(n)]\n",
        "        self.b = [np.zeros((d, 1)) for _ in range(n)]\n",
        "    def select(self, x):\n",
        "        x = x.reshape(-1, 1); best, bp = 0, -1e18\n",
        "        for a in range(self.n):\n",
        "            Ai = np.linalg.inv(self.A[a]); th = Ai @ self.b[a]\n",
        "            p = float((th.T @ x).item()) + self.alpha*float(np.sqrt((x.T @ Ai @ x).item()))\n",
        "            if p > bp: bp, best = p, a\n",
        "        return best\n",
        "    def update(self, a, x, r):\n",
        "        x = x.reshape(-1, 1); self.A[a] += x @ x.T; self.b[a] += r * x\n",
        "    def greedy(self, x):\n",
        "        x = x.reshape(-1, 1); best, bp = 0, -1e18\n",
        "        for a in range(self.n):\n",
        "            p = float(((np.linalg.inv(self.A[a]) @ self.b[a]).T @ x).item())\n",
        "            if p > bp: bp, best = p, a\n",
        "        return best\n",
        "\n",
        "X_ctx = StandardScaler().fit_transform(X_attr).astype(np.float64)\n",
        "\n",
        "def run_once(seed, rfun):\n",
        "    idx = np.arange(len(attr_df))\n",
        "    try:\n",
        "        tr, te = train_test_split(idx, test_size=0.30, stratify=true_classes,\n",
        "                                  random_state=seed)\n",
        "    except ValueError:\n",
        "        tr, te = train_test_split(idx, test_size=0.30, random_state=seed)\n",
        "\n",
        "    # honest static baseline: best action per dominant-feature bucket, learned\n",
        "    # on TRAIN from the SAME reward function the bandit sees\n",
        "    bar = defaultdict(lambda: np.zeros(len(ACTIONS)))\n",
        "    bac = defaultdict(lambda: np.zeros(len(ACTIONS)))\n",
        "    for i in tr:\n",
        "        f = dominant[i]\n",
        "        for ai, a in enumerate(ACTIONS):\n",
        "            bar[f][ai] += rfun(i, true_classes[i], a); bac[f][ai] += 1\n",
        "    smap = {f: int(np.argmax(bar[f]/np.maximum(bac[f], 1))) for f in bar}\n",
        "\n",
        "    bandit = LinUCB(len(ACTIONS), X_ctx.shape[1])\n",
        "    for i in np.random.default_rng(seed).permutation(tr):\n",
        "        a = bandit.select(X_ctx[i])\n",
        "        bandit.update(a, X_ctx[i], rfun(i, true_classes[i], ACTIONS[a]))\n",
        "\n",
        "    def ev(pick):\n",
        "        # scored on the UNWEIGHTED reward so variants are comparable\n",
        "        rs, cor, fp, nn = [], 0, 0, 0\n",
        "        for i in te:\n",
        "            a = pick(i)\n",
        "            rs.append(base_reward(true_classes[i], a))\n",
        "            cor += (a == IDEAL[true_classes[i]])\n",
        "            if true_classes[i] == \"Normal Traffic\":\n",
        "                nn += 1; fp += (a != \"allow\")\n",
        "        return cor/len(te), float(np.mean(rs)), fp/max(1, nn)\n",
        "\n",
        "    s = ev(lambda i: ACTIONS[smap.get(dominant[i], 1)])\n",
        "    b = ev(lambda i: ACTIONS[bandit.greedy(X_ctx[i])])\n",
        "    return dict(s_acc=s[0], s_rew=s[1], s_fp=s[2],\n",
        "                b_acc=b[0], b_rew=b[1], b_fp=b[2])\n",
        "\n",
        "# ---------------- run ----------------\n",
        "rows = []\n",
        "for name, rfun in VARIANTS.items():\n",
        "    print(f\"\\n{name} ...\")\n",
        "    res = pd.DataFrame([run_once(s, rfun) for s in range(SEEDS)])\n",
        "    wins  = int((res.b_rew > res.s_rew).sum())\n",
        "    p_rew = stats.wilcoxon(res.b_rew, res.s_rew).pvalue\n",
        "    rows.append({\"Reward variant\": name,\n",
        "                 \"bandit reward\": round(res.b_rew.mean(), 4),\n",
        "                 \"static reward\": round(res.s_rew.mean(), 4),\n",
        "                 \"gap pp\": round((res.b_rew.mean()-res.s_rew.mean())*100, 2),\n",
        "                 \"bandit FP\": round(res.b_fp.mean(), 4),\n",
        "                 \"static FP\": round(res.s_fp.mean(), 4),\n",
        "                 \"bandit acc\": round(res.b_acc.mean(), 4),\n",
        "                 \"wins\": f\"{wins}/{SEEDS}\", \"p(reward)\": f\"{p_rew:.2e}\"})\n",
        "    print(f\"   bandit rew {res.b_rew.mean():.4f} | FP {res.b_fp.mean():.4f} \"\n",
        "          f\"| wins {wins}/{SEEDS}\")\n",
        "\n",
        "t = pd.DataFrame(rows)\n",
        "print(\"\\n\" + \"=\" * 118)\n",
        "print(f\"REWARD ABLATION - {DATASET}, {SEEDS} seeds each, scored on the \"\n",
        "      f\"UNWEIGHTED reward so variants are comparable\")\n",
        "print(\"=\" * 118)\n",
        "print(t.to_string(index=False))\n",
        "print(\"=\" * 118)\n",
        "\n",
        "# ---------------- verdict ----------------\n",
        "g = {r[\"Reward variant\"]: r for r in rows}\n",
        "r0 = g[\"R0 flat (current)\"]\n",
        "print(\"\\nVERDICT\")\n",
        "for name in list(VARIANTS)[1:]:\n",
        "    r = g[name]\n",
        "    d_rew = (r[\"bandit reward\"] - r0[\"bandit reward\"]) * 100\n",
        "    d_fp  = (r[\"bandit FP\"]     - r0[\"bandit FP\"])     * 100\n",
        "    print(f\"  {name:26s} reward {d_rew:+6.2f} pp | benign FP {d_fp:+6.2f} pp \"\n",
        "          f\"vs the current function\")\n",
        "\n",
        "if \"R2 volume-weighted\" in g and \"R3 volume-within-class\" in g:\n",
        "    r2, r3 = g[\"R2 volume-weighted\"], g[\"R3 volume-within-class\"]\n",
        "    d2 = (r2[\"bandit reward\"] - r0[\"bandit reward\"]) * 100\n",
        "    d3 = (r3[\"bandit reward\"] - r0[\"bandit reward\"]) * 100\n",
        "    print(\"\\nTHE QUESTION THAT MATTERS - is volume weighting more than class weighting?\")\n",
        "    if d3 > 0.3:\n",
        "        print(f\"  R3 (volume WITHIN class) gains {d3:+.2f} pp with the class signal\")\n",
        "        print(\"  removed. Flow size carries information beyond which class it is.\")\n",
        "        print(\"  That is a real finding - claim it.\")\n",
