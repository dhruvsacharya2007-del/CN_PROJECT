    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# PROPOSED MODEL - GLASS-BOX EXPLAINABLE DETECTOR\n",
        "#   Random Forest + SHAP   vs   XGBoost + SHAP   vs   EBM (proposed)\n",
        "#\n",
        "# Paste as ONE cell after your Phase 2 cells.\n",
        "# Needs in memory: X_train, X_test, y_train, y_test, le\n",
        "#\n",
        "# THE ARGUMENT\n",
        "#   RF and XGBoost are black boxes. To explain them you bolt SHAP on\n",
        "#   afterwards and pay ~70 ms per flow. An Explainable Boosting Machine\n",
        "#   is a glass-box additive model: it learns one shape function per\n",
        "#   feature, so a prediction IS a sum of per-feature contributions.\n",
        "#   You read those contributions out of the model. No SHAP. No estimate.\n",
        "#   The attribution is exact and essentially free.\n",
        "#\n",
        "#   eval_terms() returns shape (flows, features, classes) - the SAME shape\n",
        "#   your pipeline already feeds the LinUCB bandit. So the glass-box model\n",
        "#   supplies the bandit's context vector at a fraction of the cost.\n",
        "#   That is what makes the detector \"lightweight explainable\" by\n",
        "#   construction rather than by accident.\n",
        "#\n",
        "# THE EXPERIMENT (3 questions)\n",
        "#   Q1 does the glass-box cost less to explain?        -> latency table\n",
        "#   Q2 what accuracy do we pay for it?                 -> same table\n",
        "#   Q3 are its attributions a VALID substitute for SHAP, i.e. would the\n",
        "#      bandit see the same context?                    -> agreement test\n",
        "#\n",
        "# FAIRNESS: all three models are trained on the SAME rows (see FIT_N).\n",
        "# Runtime: ~10-20 min, dominated by EBM training. Lower FIT_N if slow.\n",
        "# ============================================================\n",
        "\n",
        "import importlib, subprocess, sys\n",
        "# interpret-core = the EBM without the dashboard deps (installs clean on Colab)\n",
        "for _pkg, _pip in ((\"xgboost\", \"xgboost\"), (\"shap\", \"shap\"),\n",
        "                   (\"interpret\", \"interpret-core\")):\n",
        "    if importlib.util.find_spec(_pkg) is None:\n",
        "        print(f\"installing {_pip} ...\")\n",
        "        subprocess.run([sys.executable, \"-m\", \"pip\", \"install\", \"-q\", _pip], check=True)\n",
        "\n",
        "import numpy as np, pandas as pd, time, os, joblib, shap\n",
        "from xgboost import XGBClassifier\n",
        "from sklearn.ensemble import RandomForestClassifier\n",
        "from sklearn.metrics import accuracy_score, f1_score, classification_report\n",
        "from sklearn.utils.class_weight import compute_sample_weight\n",
        "from scipy.stats import spearmanr\n",
        "from interpret.glassbox import ExplainableBoostingClassifier\n",
        "\n",
        "for _v in [\"X_train\", \"X_test\", \"y_train\", \"y_test\", \"le\"]:\n",
        "    assert _v in globals(), f\"{_v} missing - re-run the Phase 2 cells first.\"\n",
        "\n",
        "os.makedirs(\"/content/artifacts\", exist_ok=True)\n",
        "DRIVE_DIR = \"/content/drive/MyDrive/CN_PROJECT/artifacts\"\n",
        "\n",
        "# ---- EBM training is the slow part. All three models use these same rows. ----\n",
        "FIT_N      = 60000     # set to None to train on the full training set\n",
        "EBM_ROUNDS = 200\n",
        "EBM_BAGS   = 4\n",
        "AGREE_N    = 1500      # flows used for the attribution-agreement test\n",
        "\n",
        "N_CLASSES  = len(le.classes_)\n",
        "N_FEATURES = X_train.shape[1]\n",
        "FEATS      = list(X_train.columns)\n",
        "\n",
        "if FIT_N is not None and FIT_N < len(X_train):\n",
        "    idx  = np.random.default_rng(42).choice(len(X_train), FIT_N, replace=False)\n",
        "    Xtr  = X_train.iloc[idx].reset_index(drop=True)\n",
        "    ytr  = np.asarray(y_train)[idx]\n",
        "    print(f\"!! all three models trained on the SAME {FIT_N:,} rows \"\n",
        "          f\"(of {len(X_train):,}) so the comparison is fair.\")\n",
        "    print(f\"   this table is therefore NOT comparable to your earlier full-data\")\n",
        "    print(f\"   RF/XGBoost numbers - quote it as its own experiment.\\n\")\n",
        "else:\n",
        "    Xtr, ytr = X_train.reset_index(drop=True), np.asarray(y_train)\n",
        "    print(f\"all three models trained on the full {len(Xtr):,} rows.\\n\")\n",
        "\n",
        "sw = compute_sample_weight(class_weight=\"balanced\", y=ytr)\n",
        "print(f\"{len(Xtr):,} train / {len(X_test):,} test | {N_FEATURES} features | \"\n",
        "      f\"{N_CLASSES} classes\\n\")\n",
        "\n",
        "\n",
        "# ---------- measurement helpers (identical treatment for every model) ----------\n",
        "def per_flow_ms(fn, X, n=100, repeats=3):\n",
        "    \"\"\"Median single-flow wall time of fn(one_row_dataframe), in ms.\"\"\"\n",
        "    _ = fn(X.iloc[[0]])                       # warm-up, discarded\n",
        "    out = []\n",
        "    for i in range(min(n, len(X))):\n",
        "        row = X.iloc[[i]]; reps = []\n",
        "        for _ in range(repeats):\n",
        "            t = time.perf_counter(); _ = fn(row)\n",
        "            reps.append((time.perf_counter() - t) * 1000)\n",
        "        out.append(np.median(reps))\n",
        "    return float(np.median(out))\n",
        "\n",
        "def evaluate(model, Xte):\n",
        "    yp = model.predict(Xte)\n",
        "    return (accuracy_score(y_test, yp),\n",
        "            f1_score(y_test, yp, average=\"macro\", zero_division=0))\n",
        "\n",
        "def attrib_3d(a):\n",
        "    \"\"\"Force an attribution array to (flows, features, classes).\"\"\"\n",
        "    if isinstance(a, list):\n",
        "        a = np.stack(a, axis=-1)\n",
        "    a = np.asarray(a)\n",
        "    if a.ndim == 2:\n",
        "        a = a[:, :, None]\n",
        "    return a\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# MODEL 1 - Random Forest + post-hoc SHAP\n",
        "# ============================================================\n",
        "print(\"[1/3] Random Forest + SHAP ...\")\n",
        "rf = RandomForestClassifier(n_estimators=100, class_weight=\"balanced\",\n",
        "                            n_jobs=-1, random_state=42)\n",
        "t0 = time.time(); rf.fit(Xtr, ytr); rf_fit = time.time() - t0\n",
        "rf_acc, rf_f1 = evaluate(rf, X_test)\n",
        "rf_expl = shap.TreeExplainer(rf)\n",
        "rf_inf  = per_flow_ms(lambda r: rf.predict(r), X_test)\n",
        "rf_xai  = per_flow_ms(lambda r: rf_expl.shap_values(r), X_test, n=60, repeats=2)\n",
        "print(f\"      acc {rf_acc:.4f} | F1 {rf_f1:.4f} | fit {rf_fit:.0f}s | \"\n",
        "      f\"explain {rf_xai:.2f} ms\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# MODEL 2 - XGBoost + post-hoc SHAP\n",
        "# ============================================================\n",
        "print(\"[2/3] XGBoost + SHAP ...\")\n",
        "xgbm = XGBClassifier(n_estimators=100, max_depth=6, learning_rate=0.3,\n",
        "                     tree_method=\"hist\", n_jobs=-1,\n",
        "                     objective=\"multi:softprob\", num_class=N_CLASSES,\n",
        "                     random_state=42, verbosity=0)\n",
        "t0 = time.time(); xgbm.fit(Xtr, ytr, sample_weight=sw); xgb_fit = time.time() - t0\n",
        "xgb_acc, xgb_f1 = evaluate(xgbm, X_test)\n",
        "xgb_expl = shap.TreeExplainer(xgbm)\n",
        "xgb_inf  = per_flow_ms(lambda r: xgbm.predict(r), X_test)\n",
        "xgb_xai  = per_flow_ms(lambda r: xgb_expl.shap_values(r), X_test, n=60, repeats=2)\n",
        "print(f\"      acc {xgb_acc:.4f} | F1 {xgb_f1:.4f} | fit {xgb_fit:.0f}s | \"\n",
        "      f\"explain {xgb_xai:.2f} ms\")\n",
        "\n",
        "\n",
        "# ============================================================\n",
        "# MODEL 3 - PROPOSED: EBM glass-box (attributions are free)\n",
        "# ============================================================\n",
        "print(f\"[3/3] EBM glass-box (proposed) - training, this is the slow one ...\")\n",
        "# interactions=0 keeps the model FULLY additive: one term per feature, so the\n",
        "# attribution vector is per-feature and directly comparable to a SHAP vector.\n",
        "ebm = ExplainableBoostingClassifier(interactions=0, max_rounds=EBM_ROUNDS,\n",
        "                                    outer_bags=EBM_BAGS, n_jobs=-1,\n",
        "                                    random_state=42)\n",
        "t0 = time.time(); ebm.fit(Xtr, ytr, sample_weight=sw); ebm_fit = time.time() - t0\n",
        "ebm_acc, ebm_f1 = evaluate(ebm, X_test)\n",
        "ebm_inf = per_flow_ms(lambda r: ebm.predict(r), X_test)\n",
        "ebm_xai = per_flow_ms(lambda r: ebm.eval_terms(r), X_test, n=60, repeats=2)\n",
        "assert len(ebm.term_features_) == N_FEATURES, \\\n",
        "    f\"EBM built {len(ebm.term_features_)} terms for {N_FEATURES} features - \" \\\n",
        "    \"interactions should be 0 for a one-term-per-feature attribution vector.\"\n",
        "print(f\"      acc {ebm_acc:.4f} | F1 {ebm_f1:.4f} | fit {ebm_fit:.0f}s | \"\n",
